# Enable only for local previews. Demo data stays in this browser.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_TELEMETRY_DISABLED=1

# Set DEMO_MODE=false and fill these in for live, invite-only operation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by the admin invitation endpoint.
SUPABASE_SERVICE_ROLE_KEY=
